    "pm2": "^7.0.1",
    "qq-official-bot": "^1.2.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/moment": "^2.11.29",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
