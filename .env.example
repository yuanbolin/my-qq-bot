# QQ 开放平台机器人凭证：https://q.qq.com/qqbot/#/developer/developer-setting
QQ_APPID=102790161
QQ_SECRET=FZuGczMk8XxNoFh9c5Z3Y3Z5c9hFoNxX
QQ_SANDBOX=false
LOG_LEVEL=info

# 应用日志目录，默认 ./logs；设为空字符串则仅输出到控制台
LOG_DIR=./logs
APP_LOG_LEVEL=info

# 连接模式：websocket（默认，无需 nginx）| webhook（经 nginx 反代）
BOT_MODE=websocket
WEBHOOK_PORT=3100
WEBHOOK_PATH=/webhook

# 静态资源目录（图片/音频）
ASSETS_DIR=./assets

# 可选：人品/rp 与冷却存储，未配置时使用内存
REDIS_URL=redis://127.0.0.1:6379

# 指令面板 feature_id 映射（管理端复制 id，格式：id:命令名）
# COMMAND_FEATURES=abc123def:早安,xyz789:帮助

# 条件回复用户 openid（逗号分隔，对应原 QQ 号）
USER_WULALA=1252432332
USER_BOSS=1252432332
USER_BOT=3889700259
# 打飞你受保护用户（建议包含 USER_BOSS、USER_BOT 及原 487827081、2721553664 的 openid）
USER_PROTECTED=

# 60s API（https://docs.60s-api.viki.moe）
SIXTY_API_BASE_URL=https://60s.viki.moe
SIXTY_API_TIMEOUT_MS=15000
SIXTY_API_MAX_TEXT_LENGTH=3500

# 摸头：openid 映射为数字 QQ（官方事件通常只有 openid）
# OPENID_QQ_MAP=ABCDEF123=123456789,OTHER_OPENID=987654321

# oick.cn QQ 头像 API（https://api.oick.cn/doc/qqtx）
OICK_QQTX_URL=https://api.oick.cn/api/qqtx
# 舔狗日记（https://api.oick.cn/doc/dog，需在 OICK_API_KEY 填写密钥）
OICK_DOG_URL=https://api.oick.cn/api/dog
# Bing 每日图（https://api.oick.cn/doc/bing）
OICK_BING_URL=https://api.oick.cn/api/bing
OICK_API_KEY=
OICK_API_TIMEOUT_MS=10000

# 随机梗图 API（https://meme-api.com/gimme）
MEME_API_URL=https://meme-api.com/gimme
MEME_API_TIMEOUT_MS=10000
# 输出的 preview 预览图数量上限
MEME_PREVIEW_LIMIT=3

# Sorry 表情包（node-sorry，需系统安装 ffmpeg）
# SORRY_FFMPEG_PATH=ffmpeg
# SORRY_CACHE_DIR=./assets/sorry/cache
# SORRY_SCALE_WIDTH=300
# SORRY_FFMPEG_FPS=8
# SORRY_FFMPEG_TIMEOUT_MS=60000

# JM 本子下载（https://github.com/hect0x7/JMComic-Crawler-Python）
# 需 Python 3.12+ 与 pip install jmcomic -U
JM_PYTHON_PATH=/usr/local/bin/python3.12
# JM_OPTION_PATH=./config/jmcomic.option.yml
# JM_SCRIPT_PATH=./scripts/jm_export.py
# JM_JOBS_DIR=./data/jm/jobs
# JM_TIMEOUT_MS=600000
# JM_COOLDOWN_MS=300000
# JM_MAX_PAGES=200
# JM_ALLOWED_USERS=openid1,openid2
