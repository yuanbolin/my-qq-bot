# QQ 开放平台：https://q.qq.com/qqbot/#/developer/developer-setting
QQ_APPID=your_app_id
QQ_SECRET=your_app_secret
QQ_SANDBOX=false

LOG_LEVEL=info

# 连接模式：websocket（默认，无需 nginx）| webhook（经 nginx 反代）
BOT_MODE=websocket
WEBHOOK_PORT=3100
WEBHOOK_PATH=/webhook

# 静态资源目录（图片/音频）
ASSETS_DIR=./assets

# 可选：人品/rp 与冷却存储，未配置时使用内存
REDIS_URL=redis://127.0.0.1:6379

# 条件回复用户 openid（逗号分隔）
USER_WULALA=
USER_BOSS=
